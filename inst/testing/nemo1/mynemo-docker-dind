     set -- --net_init_first --prune-outer --copy-certs-to-hostdir "$@" -q
   fi     

   ##

   while [ $# -gt 0 ]; do #arg loop

     if [ "$1" = "-x" ]; then #arg 
       shift 1       
       set -x
     elif [ "$1" = "--net_init_first" ]; then #arg 
