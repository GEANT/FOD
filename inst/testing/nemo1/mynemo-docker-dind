   "$0" --nemo-get-filename-of-certfile 

   ##

   [ -z "$use_addon1" -o "$addon_init_early" = 1 ] || "$0" --addon-init-main "$use_addon1"
   [ -z "$use_addon1" -o "$addon_init_early" = 1 ] || "$0" --addon-init-nemodetection-adapt "$use_addon1" 
     
   [ -z "$use_addon1" ] || "$0" --addon-init-vsmd-adapt "$use_addon1" 

#arg  

