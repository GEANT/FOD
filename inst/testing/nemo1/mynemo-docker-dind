function check_dep_sys_cmds_avail()
{
  echo "$0: verifying that necessary command dependencies are available:" 1>&2  
  for cmd in ${DEP_SYS_COMMANDS[@]}; do
    if ! type "$cmd" 1>&2; then
      echo "$0: command '$cmd' not found in PATH=$PATH, aborting" 1>&2
      exit 1
    fi  
  done
  echo 1>&2

  ${nonroot_prefix_cmd} ./frnet/docker-compose/freertr_disable_offload.sh --only_verify_dep_sys_cmds_avail
}

if [ "$1" = "--only_verify_dep_sys_cmds_avail0" ]; then #arg 
  shift 1
	 
  check_dep_sys_cmds_avail

elif [ "$1" = "--only_verify_dep_sys_cmds_avail" ]; then #arg 
  shift 1
	 
  "$0" --only_verify_dep_sys_cmds_avail0

  [ ! -e ./nemo1.env ] || . ./nemo1.env

  [ -z "$use_addon1" ] || "$0" --addon-init-run "$use_addon1" --only_verify_dep_sys_cmds_avail || exit 1

