        # Create an certificate for an admin user
        openssl genrsa -out "$ADMIN_NAME_FILE.key" 2048
	# C = LO, ST = Local, L = Local, O = NeMo, OU = NeMo Test Instance, CN = localhost
        openssl req -new -key "$ADMIN_NAME_FILE.key" -out "$ADMIN_NAME_FILE.csr" -subj "/C=LO/ST=Local/L=Local/O=NeMo/OU=NeMo Test Instance/CN=localhost/emailAddress=${ADMIN_MAIL}"
        openssl ca -cert ./secrets/CA.pem -keyfile ./secrets/CA.key -in "$ADMIN_NAME_FILE.csr" -out "$ADMIN_NAME_FILE.crt"
        openssl x509 -sha256 -req -in "$ADMIN_NAME_FILE.csr" -out "$ADMIN_NAME_FILE.crt" -CA ./secrets/CA.pem -CAkey ./secrets/CA.key \
          -CAcreateserial -days 1095
        echo ""
	echo "Your certificate is exported into a .p12 which can be imported into the browser (password='')"
        echo "The exported file is password protected"
        openssl pkcs12 -export -password 'pass:' -out "$ADMIN_NAME_FILE.p12" -inkey "$ADMIN_NAME_FILE.key" -in "$ADMIN_NAME_FILE.crt"
