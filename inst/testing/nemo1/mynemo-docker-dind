    #set -- sh -c "git log --graph --abbrev-commit '--pretty=format:%h%x09%an%x09%ad%x09%d %s' -n 1 | head -1; git status"
    set -- sh -c "git log --graph --abbrev-commit '--pretty=format:%h%x09%an%x09%ad%x09%d %s' -n 1 | head -1; git diff"
    #use_short=1
  fi

  if [ "$1" = "--short" ]; then #arg
    use_short="$1" #arg
    shift 1
  fi

  ##

  echo "# nemo git repos do: $*:" 1>&2
  for dir1 in nemo-*/; do
    if [ -d "$dir1/.git" ]; then
      [ "$use_short" = 0 ] && echo "# $dir1: " || echo -n "$dir1: "
      (cd "$dir1" && "$@") 2>&1 | awk '{ print; }'
      [ "$use_short" = 1 ] || echo 
    fi
  done
  echo 

#arg  

elif [ "$1" = "--allx" ]; then #arg # all-in-one mode for building+running outer nemo-all container + build+run freertr+test-hosts outer docker containers: inside outer nemo-all container init+run nemo detection inner containers and vsmd(=nemo mitigation) inner container etc; will do everything in the rights order to setup everything
   shift 1

   net_init_first=0
   use_addon1=""
   use_addon1_arg=""
   addon_init_early=0

   vsmd_args=("--vsmd_inbg")

   if [ $# = 0 ]; then
